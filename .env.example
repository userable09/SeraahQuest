# GROQ_API_KEY: Optional/Primary key for Groq Llama 3.3 70B, Mixtral, and DeepSeek models.
GROQ_API_KEY=""

# GEMINI_API_KEY: Required for fallback Gemini AI API calls if GROQ_API_KEY is not supplied.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
